{
  "name": "gladys-anova",
  "version": "0.1.1",
  "private": true,
  "description": "Anova Precision Cookers (sous vide) and Precision Ovens for Gladys Assistant through the official Anova Developer WebSocket API: temperature, target, timer, state and alerts, a stop that is never refused, and a sous vide start behind an off-by-default option.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-anova.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "license": "Apache-2.0"
}
